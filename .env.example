# Copy to backend/.env and fill in. Never commit backend/.env.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
# true = skip all Claude calls and return canned responses (duplicate check stays real)
MOCK_MODE=false
# Relative paths resolve against backend/
DATA_DIR=./data
CORS_ORIGINS=http://localhost:5173
DUP_PHASH_NEAR=6
DUP_PHASH_POSSIBLE=12
MAX_UPLOAD_MB=10
